        "description": "Specific block type to get schema for (optional, returns all if not specified).",
        "enum": [
          "teaser",
          "slate",
          "__button",
          "separator",
          "image",
          "gridBlock",
          "listing",
        ],
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "plone_get_block_schemas",
}
`;

