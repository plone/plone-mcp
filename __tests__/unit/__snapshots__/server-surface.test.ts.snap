exports[`server surface > keeps every tool's description, annotations and input schema > plone_add_single_block 1`] = `
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false,
  },
  "description": "Adds a single new block to an existing content item without replacing other blocks. Specify the block type, data, and either position or afterBlockId (insert directly after an existing block; block IDs are returned by plone_get_content). Example: plone_add_single_block({path: '/my-page', blockType: 'slate', blockData: {text: 'New paragraph'}})",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "afterBlockId": {
        "description": "ID of an existing block to insert the new block directly after. Get block IDs from plone_get_content: every key in the 'blocks' object is a block ID, and 'blocks_layout.items' lists them in rendering order. Cannot be combined with 'position'. Optional; if omitted, 'position' or append-to-end is used.",
        "type": "string",
      },
      "blockData": {
        "additionalProperties": {},
        "description": "Block-specific data",
        "propertyNames": {
          "type": "string",
        },
        "type": "object",
      },
      "blockType": {
        "description": "Type of block to add",
        "enum": [
          "teaser",
          "slate",
          "__button",
          "separator",
          "image",
          "gridBlock",
          "listing",
        ],
        "type": "string",
      },
      "path": {
        "description": "Path to the content",
        "type": "string",
      },
      "position": {
        "description": "Position to insert the block (optional, defaults to end)",
        "type": "number",
      },
    },
    "required": [
      "path",
      "blockType",
      "blockData",
    ],
    "type": "object",
  },
  "name": "plone_add_single_block",
}
`;

