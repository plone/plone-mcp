exports[`server surface > keeps every tool's description, annotations and input schema > plone_configure 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false,
  },
  "description": "Establishes and authenticates the connection to a Plone CMS. **Must be called once per session** before other tools can be used. Configuration can be provided via arguments or environment variables (PLONE_BASE_URL, PLONE_USERNAME, PLONE_PASSWORD, PLONE_TOKEN). Arguments take precedence over environment variables. To use environment variables only, call with an empty object: plone_configure({}). Example with arguments: plone_configure({baseUrl: 'https://demo.plone.org', username: 'admin', password: 'secret'}).",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "description": "Base URL of the Plone site. Can be set via PLONE_BASE_URL environment variable.",
        "type": "string",
      },
      "password": {
        "description": "Password for authentication. Can be set via PLONE_PASSWORD environment variable.",
        "type": "string",
      },
      "token": {
        "description": "JWT token for authentication (alternative to username/password). Can be set via PLONE_TOKEN environment variable.",
        "type": "string",
      },
      "username": {
        "description": "Username for authentication. Can be set via PLONE_USERNAME environment variable.",
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "plone_configure",
}
`;

exports[`server surface > keeps every tool's description, annotations and input schema > plone_copy_content 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
  },
  "description": "Copies one or more content items into a destination container, leaving the originals in place. Sources may be given by URL, path, or UID; pass a single string or an array. Copies are auto-named 'copy_of_<id>', so the response maps each source to its new target URL. Requires the AddPortalContent permission on the destination. Example: plone_copy_content({parentPath: '/folder', source: '/front-page'})",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "parentPath": {
        "description": "Path of the destination container to copy into (e.g., '/folder' or '/' for the site root)",
        "type": "string",
      },
      "source": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string",
          },
          {
            "items": {
              "minLength": 1,
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
        ],
        "description": "Source object(s) to copy, each specified by URL, path, or UID. Pass a single string or an array for multiple objects",
      },
    },
    "required": [
      "parentPath",
      "source",
    ],
    "type": "object",
  },
  "name": "plone_copy_content",
}
`;

exports[`server surface > keeps every tool's description, annotations and input schema > plone_create_blocks_layout 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false,
  },
  "description": "Prepares a complete block structure in memory (valid for 60 seconds). This structure is then used by the **next immediate call** to \`plone_create_content\` or \`plone_update_content\`. Use \`plone_get_block_schemas\` to learn what data each block type needs. The text displayed by the Title block is automatically managed by Plone, DO NOT add it in the block's data. Example: plone_create_blocks_layout({blocks: [{type: 'slate', data: {text: 'Hello World'}}]})",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "blocks": {
        "description": "Array of block specifications to process. You MUST call plone_get_block_schemas first to see available block types and their required fields. You MUST follow the block specifications EXACTLY, DO NOT invent your own fields. DO NOT add the content object's title in a text block. To set the page title, use the 'title' field of the content object itself when calling plone_create_content or plone_update_content. A Title block will be automatically created by Plone.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "data": {
              "additionalProperties": {},
              "description": "Block-specific data following the block specification",
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "type": {
              "description": "Type of block to create",
              "enum": [
                "teaser",
                "slate",
                "__button",
                "separator",
                "image",
                "gridBlock",
                "listing",
              ],
              "type": "string",
            },
          },
          "required": [
            "type",
            "data",
          ],
          "type": "object",
        },
        "type": "array",
      },
    },
    "required": [
      "blocks",
    ],
    "type": "object",
  },
  "name": "plone_create_blocks_layout",
}
`;

exports[`server surface > keeps every tool's description, annotations and input schema > plone_create_content 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
  },
  "description": "Creates a new content item (e.g., a page or news article) in Plone. To add complex block-based content, first prepare the structure with \`plone_create_blocks_layout\`, then call this tool. Example: plone_create_content({parentPath: '/', type: 'Document', title: 'My Page', description: 'A sample page'})",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "additionalFields": {
        "additionalProperties": {},
        "description": "Additional fields to update. For preview images, include preview_image_link: { '@id': 'image-url' } in this object (if you get a 400 error, make sure the image URL is accessible).",
        "propertyNames": {
          "type": "string",
        },
        "type": "object",
      },
      "blocks": {
        "additionalProperties": {},
        "description": "Volto blocks structure for the content, it specifies the blocks data and content",
        "propertyNames": {
          "type": "string",
        },
        "type": "object",
      },
      "blocks_layout": {
        "additionalProperties": {},
        "description": "Volto blocks layout configuration, it specifies the order of blocks",
        "propertyNames": {
          "type": "string",
        },
        "type": "object",
      },
      "description": {
        "description": "Description of the new content",
        "type": "string",
      },
      "id": {
        "description": "ID for the new content (optional, will be auto-generated if not provided)",
        "type": "string",
      },
      "parentPath": {
        "description": "Path where to create the content (e.g., '/parentDocument/document' or '/' for root)",
        "type": "string",
      },
      "title": {
        "description": "Title of the new content",
        "type": "string",
      },
      "type": {
        "description": "Content type to create (e.g., 'Document', 'Event', 'News Item')",
        "type": "string",
      },
    },
    "required": [
      "parentPath",
      "type",
      "title",
    ],
    "type": "object",
  },
  "name": "plone_create_content",
}
`;

exports[`server surface > keeps every tool's description, annotations and input schema > plone_create_user 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
  },
  "description": "Creates a new user in the Plone site. Requires Manager role or self-registration to be enabled. Example: plone_create_user({username: 'jdoe', password: 'secret', email: 'jdoe@example.com', fullname: 'John Doe', roles: ['Contributor']})",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "description": {
        "description": "Short biography or description of the user",
        "type": "string",
      },
      "email": {
        "description": "Email address of the user",
        "type": "string",
      },
      "fullname": {
        "description": "Full name of the user",
        "type": "string",
      },
      "home_page": {
        "description": "URL of the user's home page",
        "type": "string",
      },
      "location": {
        "description": "Location of the user",
        "type": "string",
      },
      "password": {
        "description": "Password for the new user, it must be 8 characters or longer. Unless specified otherwise, use 12345678 as the default password for created users.",
        "type": "string",
      },
      "roles": {
        "description": "Roles to assign to the user (e.g., ['Contributor', 'Editor'])",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "sendPasswordReset": {
        "description": "If true, send a password reset email to the user instead of setting the password directly",
        "type": "boolean",
      },
      "username": {
        "description": "Username for the new user",
        "type": "string",
      },
    },
    "required": [
      "username",
      "password",
    ],
    "type": "object",
  },
  "name": "plone_create_user",
}
`;

exports[`server surface > keeps every tool's description, annotations and input schema > plone_create_working_copy 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
  },
  "description": "Checks out a content item, creating a working copy that can be edited without touching the published original. The original is locked until the working copy is checked in or cancelled. The copy is created next to the original as 'working_copy_of_<id>', so use the '@id' from the response instead of building that path yourself. Example: plone_create_working_copy({path: '/my-document'})",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "path": {
        "description": "Path to the content item to check out",
        "type": "string",
      },
    },
    "required": [
      "path",
    ],
    "type": "object",
  },
  "name": "plone_create_working_copy",
}
`;

