    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
  },
  "description": "Moves one or more content items into a destination container, removing them from their current location. Sources may be given by URL, path, or UID; pass a single string or an array. Requires the DeleteObjects permission on the source's parent and AddPortalContent on the destination. Example: plone_move_content({parentPath: '/folder', source: '/front-page'})",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "parentPath": {
        "description": "Path of the destination container to move into (e.g., '/folder' or '/' for the site root)",
        "type": "string",
      },
      "source": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string",
          },
          {
            "items": {
              "minLength": 1,
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
        ],
        "description": "Source object(s) to move, each specified by URL, path, or UID. Pass a single string or an array for multiple objects",
      },
    },
    "required": [
      "parentPath",
      "source",
    ],
    "type": "object",
  },
  "name": "plone_move_content",
}
`;

